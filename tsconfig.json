{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "outDir": "outputs",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,

    "moduleResolution": "Bundler",

    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,

    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": ["sources", "tests"]
}
