{
  "name": "@everyonesoftware/common",
  "version": "5.0.0",
  "description": "A package containing common code for everyonesoftware projects.",
  "repository": {
    "url": "https://github.com/everyonesoftware/common-typescript"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "outputs/",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./outputs/sources.d.ts",
      "import": "./outputs/sources.js",
      "require": "./outputs/sources.cjs"
    },
    "./tests": {
      "types": "./outputs/tests.d.ts",
      "import": "./outputs/tests.js",
      "require": "./outputs/tests.cjs"
    }
  },
  "scripts": {
    "build": "barrelsby --directory sources --delete && tsup",
    "clean": "rimraf coverage outputs",
    "test-only": "c8 node -r source-map-support/register outputs/tests.js",
    "test": "npm run build && npm run test-only"
  },
  "dependencies": {
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "@types/luxon": "3.7.1",
    "barrelsby": "2.8.1",
    "c8": "^11.0.0",
    "rimraf": "6.0.1",
    "source-map-support": "0.5.21",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}